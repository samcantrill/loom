# Owner-protected machine values. Copy to agent.env and replace each value.
LOOM_AGENT_ROOT=/secure/loom/remote-agent
LOOM_COORDINATOR_URL=https://coordinator.example:9443
LOOM_SERVER_CA=/secure/loom/tls/ca.crt
LOOM_AGENT_CERTIFICATE=/secure/loom/tls/agent.crt
LOOM_AGENT_PRIVATE_KEY=/secure/loom/tls/agent.key
LOOM_PROJECT_ROOT=/work/project
LOOM_PYTHON=/work/project/.venv/bin/python
