# Owner-protected machine values. Copy to coordinator.env and replace each value.
LOOM_DEPLOYMENT_ROOT=/secure/loom/remote-coordinator/deployment
LOOM_RUN_STORE_ROOT=/secure/loom/remote-coordinator/runs
LOOM_MACHINE_ID=coordinator-machine
LOOM_AGENT_HOST=localhost
LOOM_AGENT_PORT=9443
LOOM_SERVER_CERTIFICATE=/secure/loom/tls/server.crt
LOOM_SERVER_PRIVATE_KEY=/secure/loom/tls/server.key
LOOM_CLIENT_CA=/secure/loom/tls/ca.crt
