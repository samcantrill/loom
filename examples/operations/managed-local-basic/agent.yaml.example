schema_version: 3
kind: loom.local-agent-service
agent_root: ${oc.env:LOOM_AGENT_ROOT}
resident_profiles:
  - descriptor:
      profile_id: starter-local
      revision: v1
    project_root: ${oc.env:LOOM_PROJECT_ROOT}
    python_executable: ${oc.env:LOOM_PYTHON}
    cpu_capacity: 1
    memory_capacity_bytes: 0
    gpu_devices: []
    environment: {}
    readiness:
      imports: [loom, stages]
      import_roots:
        stages: .
      source_roots: [stages.py]
